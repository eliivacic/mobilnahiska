# Copy to .env.local and fill in real values. Never commit .env.local.

# --- DATABASE / AUTH (Supabase) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- CRON ---
# Bearer token required on requests to /api/cron/reminders. Any random
# string; must match the value configured on the Vercel Cron Job.
CRON_SECRET=

# --- EMAIL (Resend) ---
# Sending is safely skipped (logged as skipped_no_provider) when unset.
RESEND_API_KEY=

# --- STRIPE ---
# Do NOT set these until the final go-live step — see HANDOVER_CHECKLIST.md.
# Leaving them unset keeps every payment CTA disabled with a clear
# "Plačilni sistem še ni aktiviran" message; no code change is needed to
# activate them later, only these two values.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- ANALYTICS ---
# Not read from env today (GA4 measurement ID is inlined in
# src/components/consent/AnalyticsScripts.tsx, only loaded after cookie
# consent is granted) — listed here as a placeholder in case it moves to
# env later.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- ERROR MONITORING ---
# Not yet integrated. Add the relevant DSN/env vars here if/when a provider
# (e.g. Sentry) is chosen.
